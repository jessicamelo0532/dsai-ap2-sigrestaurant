generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
  MERGED
  // SPEC/2026-11-17-contas-a-receber.md: fechada a prazo, com título a receber.
  ON_ACCOUNT
}

enum ReceivableStatus {
  OPEN
  PAID
}

enum OrderEventType {
  TRANSFER
  MERGE
}

enum PaymentMethod {
  CASH
  CREDIT
  DEBIT
  PIX
}

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
}

enum StockUnit {
  UN
  KG
  G
  L
  ML
}

enum StockMovementType {
  PURCHASE
  LOSS
  ADJUSTMENT
  SALE
}

enum PurchaseStatus {
  OPEN
  PAID
  CANCELLED
}

enum ClosingStatus {
  CLOSED
  REOPENED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  WITHDRAWAL
  DEPOSIT
}

model DiningTable {
  id           Int           @id @default(autoincrement())
  number       Int           @unique
  capacity     Int           @default(4)
  createdAt    DateTime      @default(now())
  // SPEC/2026-11-17-zonas-do-salao.md: toda mesa pertence a uma zona.
  zoneId       Int
  zone         Zone          @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  orders       Order[]
  reservations Reservation[]

  @@index([zoneId])
}

// Zonas do salão (SPEC/2026-11-17-zonas-do-salao.md).
model Zone {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  sortOrder Int
  createdAt DateTime      @default(now())
  tables    DiningTable[]
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  category    String       @default("Geral")
  price       Decimal      @db.Decimal(10, 2)
  available   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
  recipeItems RecipeItem[]
  availability MenuAvailability[]
  categoryId   Int?
  menuCategory MenuCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     MenuVariant[]
  addons       MenuAddon[]

  @@index([categoryId])
}

model Order {
  id             Int             @id @default(autoincrement())
  tableId        Int?
  tableNumber    Int
  status         OrderStatus     @default(OPEN)
  paymentMethod  PaymentMethod?
  openedAt       DateTime        @default(now())
  paidAt         DateTime?
  waiterId       Int?
  waiterName     String?
  commissionRate Decimal?        @db.Decimal(5, 2)
  mergedIntoId   Int?
  table          DiningTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiter         Waiter?         @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  stockMovements StockMovement[]
  events         OrderEvent[]
  kitchenTickets KitchenTicket[]
  customerId     Int?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount       Decimal         @default(0) @db.Decimal(10, 2)
  channel        OrderChannel    @default(DINE_IN)
  deliveryFee    Decimal         @default(0) @db.Decimal(10, 2)
  recipient       String?
  deliveryAddress String?
  deliveryPhone   String?
  deliveryStatus  DeliveryStatus?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  loyaltyPoints  Int             @default(0)
  loyaltyEntries LoyaltyEntry[]
  receivable     Receivable?

  @@index([status, openedAt])
  @@index([paidAt])
  @@index([waiterId])
  @@index([customerId])
  @@index([channel, status])
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  menuItemId    Int?
  nameSnapshot  String
  unitPrice     Decimal  @db.Decimal(10, 2)
  quantity      Int
  createdAt     DateTime @default(now())
  ticketId      Int?
  variantName   String?
  addons        OrderItemAddon[]
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  ticket        KitchenTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([ticketId])
}

model Expense {
  id          Int       @id @default(autoincrement())
  description String
  amount      Decimal   @db.Decimal(10, 2)
  incurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  purchase    Purchase?

  @@index([incurredAt])
}

model Reservation {
  id            Int               @id @default(autoincrement())
  tableId       Int?
  tableNumber   Int
  customerName  String
  customerPhone String?
  partySize     Int
  startsAt      DateTime
  endsAt        DateTime
  status        ReservationStatus @default(BOOKED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  table         DiningTable?      @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([tableId, startsAt])
  @@index([startsAt])
}

model Ingredient {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  unit            StockUnit
  quantity        Decimal         @default(0) @db.Decimal(12, 3)
  minimumQuantity Decimal         @default(0) @db.Decimal(12, 3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  recipeItems     RecipeItem[]
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Decimal    @db.Decimal(12, 3)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
}

model StockMovement {
  id           Int               @id @default(autoincrement())
  ingredientId Int
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  orderId      Int?
  purchaseId   Int?
  note         String?
  createdAt    DateTime          @default(now())
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase     Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([ingredientId, createdAt])
  @@index([orderId])
  @@index([purchaseId])
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  document  String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

model Purchase {
  id             Int             @id @default(autoincrement())
  supplierId     Int
  invoiceNumber  String?
  purchasedAt    DateTime        @db.Date
  dueDate        DateTime        @db.Date
  total          Decimal         @db.Decimal(10, 2)
  status         PurchaseStatus  @default(OPEN)
  paymentMethod  PaymentMethod?
  paidAt         DateTime?       @db.Date
  expenseId      Int?            @unique
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([status, dueDate])
  @@index([supplierId])
}

model PurchaseItem {
  id             Int         @id @default(autoincrement())
  purchaseId     Int
  ingredientId   Int?
  ingredientName String
  unit           StockUnit
  quantity       Decimal     @db.Decimal(12, 3)
  unitCost       Decimal     @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  purchase       Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient     Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([ingredientId])
}

model MonthlyClosing {
  id            Int           @id @default(autoincrement())
  month         String        @unique
  status        ClosingStatus @default(CLOSED)
  revision      Int           @default(1)
  revenue       Decimal       @db.Decimal(12, 2)
  cash          Decimal       @db.Decimal(12, 2)
  credit        Decimal       @db.Decimal(12, 2)
  debit         Decimal       @db.Decimal(12, 2)
  pix           Decimal       @db.Decimal(12, 2)
  purchases     Decimal       @db.Decimal(12, 2)
  otherExpenses Decimal       @db.Decimal(12, 2)
  result        Decimal       @db.Decimal(12, 2)
  paidOrders    Int
  averageTicket Decimal       @db.Decimal(12, 2)
  notes         String?
  closedAt      DateTime      @default(now())
  reopenedAt    DateTime?
  reopenReason  String?
  updatedAt     DateTime      @updatedAt
}

model CashSession {
  id             Int               @id @default(autoincrement())
  status         CashSessionStatus @default(OPEN)
  openedBy       String
  openingAmount  Decimal           @db.Decimal(10, 2)
  openedAt       DateTime
  closedBy       String?
  closedAt       DateTime?
  expectedCash   Decimal?          @db.Decimal(10, 2)
  expectedCredit Decimal?          @db.Decimal(10, 2)
  expectedDebit  Decimal?          @db.Decimal(10, 2)
  expectedPix    Decimal?          @db.Decimal(10, 2)
  countedCash    Decimal?          @db.Decimal(10, 2)
  countedCredit  Decimal?          @db.Decimal(10, 2)
  countedDebit   Decimal?          @db.Decimal(10, 2)
  countedPix     Decimal?          @db.Decimal(10, 2)
  notes          String?
  movements      CashMovement[]

  @@index([status])
  @@index([openedAt])
}

model CashMovement {
  id        Int              @id @default(autoincrement())
  sessionId Int
  type      CashMovementType
  amount    Decimal          @db.Decimal(10, 2)
  reason    String
  createdAt DateTime
  session   CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Waiter {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  commissionRate Decimal  @default(10) @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model OrderEvent {
  id              Int            @id @default(autoincrement())
  orderId         Int
  type            OrderEventType
  fromTableNumber Int?
  toTableNumber   Int?
  sourceOrderId   Int?
  reason          String
  createdAt       DateTime       @default(now())
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Cozinha (SPEC/2026-11-16-cozinha-kds.md)
enum KitchenTicketStatus {
  QUEUED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum KitchenPriority {
  NORMAL
  HIGH
}

model KitchenTicket {
  id              Int                     @id @default(autoincrement())
  orderId         Int
  status          KitchenTicketStatus     @default(QUEUED)
  priority        KitchenPriority         @default(NORMAL)
  note            String?
  sentAt          DateTime
  startedAt       DateTime?
  readyAt         DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  priorityChanges KitchenPriorityChange[]

  @@index([status, sentAt])
  @@index([orderId])
}

model KitchenPriorityChange {
  id        Int             @id @default(autoincrement())
  ticketId  Int
  from      KitchenPriority
  to        KitchenPriority
  changedBy String
  changedAt DateTime
  ticket    KitchenTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Clientes (SPEC/2026-11-16-clientes-e-historico.md)
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  nameKey   String
  phone     String?
  notes     String?
  dedupeKey String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders         Order[]
  loyaltyEntries LoyaltyEntry[]
  receivables    Receivable[]

  @@index([nameKey])
}

// Fidelidade (SPEC/2026-11-16-programa-de-fidelidade.md)
enum LoyaltyEntryType {
  EARN
  REDEEM
  REFUND
}

model LoyaltySettings {
  id              Int      @id @default(1)
  pointsPerReal   Int
  centsPerPoint   Int
  minRedeemPoints Int
  updatedAt       DateTime @updatedAt
}

model LoyaltyEntry {
  id         Int              @id @default(autoincrement())
  customerId Int
  orderId    Int?
  type       LoyaltyEntryType
  points     Int
  createdAt  DateTime         @default(now())
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([orderId])
}

// Disponibilidade por horário (SPEC/2026-11-16-cardapio-por-horario.md)
model MenuAvailability {
  id          Int      @id @default(autoincrement())
  menuItemId  Int
  weekday     Int
  startMinute Int
  endMinute   Int
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

// Categorias do cardápio (SPEC/2026-11-16-categorias-do-cardapio.md)
model MenuCategory {
  id        Int        @id @default(autoincrement())
  name      String
  nameKey   String     @unique
  sortOrder Int
  createdAt DateTime   @default(now())
  items     MenuItem[]
}

// Variações e adicionais (SPEC/2026-11-16-variacoes-e-adicionais.md)
model MenuVariant {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  name       String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model MenuAddon {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  name       String
  price      Decimal  @db.Decimal(10, 2)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model OrderItemAddon {
  id           Int       @id @default(autoincrement())
  orderItemId  Int
  nameSnapshot String
  price        Decimal   @db.Decimal(10, 2)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

// Metas de vendas (SPEC/2026-11-16-metas-de-vendas.md)
model SalesGoal {
  id            Int      @id @default(autoincrement())
  month         String   @unique
  revenue       Decimal? @db.Decimal(12, 2)
  orders        Int?
  averageTicket Decimal? @db.Decimal(10, 2)
  updatedAt     DateTime @updatedAt
}

// Delivery (SPEC/2026-11-16-delivery.md)
enum OrderChannel {
  DINE_IN
  DELIVERY
}

enum DeliveryStatus {
  RECEIVED
  OUT_FOR_DELIVERY
  DELIVERED
}

// Horário de funcionamento da casa (SPEC/2026-11-17-horario-de-funcionamento.md).
model OpeningHour {
  id          Int @id @default(autoincrement())
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([weekday])

}

// Contas a receber (SPEC/2026-11-17-contas-a-receber.md): um título por comanda vendida a prazo.
model Receivable {
  id            Int              @id @default(autoincrement())
  orderId       Int              @unique
  customerId    Int
  amount        Decimal          @db.Decimal(10, 2)
  issuedAt      DateTime         @db.Date
  dueDate       DateTime         @db.Date
  status        ReceivableStatus @default(OPEN)
  paymentMethod PaymentMethod?
  receivedAt    DateTime?        @db.Date
  notes         String?
  createdAt     DateTime         @default(now())
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([status, dueDate])
  @@index([customerId])
}
