generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT
  DEBIT
  PIX
}

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
}

enum StockUnit {
  UN
  KG
  G
  L
  ML
}

enum StockMovementType {
  PURCHASE
  LOSS
  ADJUSTMENT
  SALE
}

enum PurchaseStatus {
  OPEN
  PAID
  CANCELLED
}

model DiningTable {
  id           Int           @id @default(autoincrement())
  number       Int           @unique
  capacity     Int           @default(4)
  createdAt    DateTime      @default(now())
  orders       Order[]
  reservations Reservation[]
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  category    String       @default("Geral")
  price       Decimal      @db.Decimal(10, 2)
  available   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
  recipeItems RecipeItem[]
}

model Order {
  id             Int             @id @default(autoincrement())
  tableId        Int?
  tableNumber    Int
  status         OrderStatus     @default(OPEN)
  paymentMethod  PaymentMethod?
  openedAt       DateTime        @default(now())
  paidAt         DateTime?
  table          DiningTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([status, openedAt])
  @@index([paidAt])
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  menuItemId    Int?
  nameSnapshot  String
  unitPrice     Decimal  @db.Decimal(10, 2)
  quantity      Int
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Expense {
  id          Int       @id @default(autoincrement())
  description String
  amount      Decimal   @db.Decimal(10, 2)
  incurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  purchase    Purchase?

  @@index([incurredAt])
}

model Reservation {
  id            Int               @id @default(autoincrement())
  tableId       Int?
  tableNumber   Int
  customerName  String
  customerPhone String?
  partySize     Int
  startsAt      DateTime
  endsAt        DateTime
  status        ReservationStatus @default(BOOKED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  table         DiningTable?      @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([tableId, startsAt])
  @@index([startsAt])
}

model Ingredient {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  unit            StockUnit
  quantity        Decimal         @default(0) @db.Decimal(12, 3)
  minimumQuantity Decimal         @default(0) @db.Decimal(12, 3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  recipeItems     RecipeItem[]
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Decimal    @db.Decimal(12, 3)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
}

model StockMovement {
  id           Int               @id @default(autoincrement())
  ingredientId Int
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  orderId      Int?
  purchaseId   Int?
  note         String?
  createdAt    DateTime          @default(now())
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase     Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([ingredientId, createdAt])
  @@index([orderId])
  @@index([purchaseId])
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  document  String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

model Purchase {
  id             Int             @id @default(autoincrement())
  supplierId     Int
  invoiceNumber  String?
  purchasedAt    DateTime        @db.Date
  dueDate        DateTime        @db.Date
  total          Decimal         @db.Decimal(10, 2)
  status         PurchaseStatus  @default(OPEN)
  paymentMethod  PaymentMethod?
  paidAt         DateTime?       @db.Date
  expenseId      Int?            @unique
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([status, dueDate])
  @@index([supplierId])
}

model PurchaseItem {
  id             Int         @id @default(autoincrement())
  purchaseId     Int
  ingredientId   Int?
  ingredientName String
  unit           StockUnit
  quantity       Decimal     @db.Decimal(12, 3)
  unitCost       Decimal     @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  purchase       Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient     Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([ingredientId])
}
